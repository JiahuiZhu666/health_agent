# Server-only configuration. Copy to .env and keep credentials out of Git.
# The browser cannot view or change these settings.
# Verify from your local terminal: bash scripts/start.command --test-api
# Ordinary chat uses this connection; optional blind measurement is additional.
NHIS_MODEL_PROVIDER=openai
NHIS_MODEL_BASE_URL=https://api.openai.com/v1
NHIS_MODEL_NAME=gpt-5.6-sol
OPENAI_API_KEY=

# Public browser access is opt-in locally. The Render preview enables it.
# Keep this separate from OPENAI_API_KEY. Public mode uses it to sign visitor
# cookies; private hosted mode uses it as the owner Basic-auth password.
# Required for either hosted mode, at least 32 random characters; never publish.
NHIS_PUBLIC_ACCESS=false
WEB_AUTH_SECRET=

# All limits must be integers from 1 through 100000. Hourly limits are per
# visitor; daily limits are global rolling 24-hour caps, not calendar-day quotas.
NHIS_PUBLIC_MESSAGES_PER_HOUR=20
NHIS_PUBLIC_MESSAGES_PER_DAY=200
NHIS_PUBLIC_CHATS_PER_HOUR=10
NHIS_PUBLIC_CHATS_PER_DAY=200

# Runtime limits. The R memory value caps Linux address space; on macOS it
# limits R's vector heap, not total resident memory. See docs/upgrade-implementation.md.
NHIS_HTTP_MAX_THREADS=32
NHIS_HTTP_LISTEN_BACKLOG=64
NHIS_HTTP_READ_TIMEOUT=10
NHIS_HTTP_CONNECTION_DEADLINE=30
NHIS_JOB_WALL_SECONDS=900
NHIS_R_MAX_WORKERS=1
NHIS_R_CPU_SECONDS=240
NHIS_R_WALL_SECONDS=240
NHIS_R_MEMORY_MB=1536
NHIS_R_OUTPUT_BYTES=16777216
NHIS_R_STEPS_PER_TURN=12

# Conservative model reservations, separate from public message quotas.
# Cost values are microUSD at configurable planning rates, not a provider bill.
NHIS_BUDGET_TURN_CALLS=400
NHIS_BUDGET_TURN_INPUT_TOKENS=2000000
NHIS_BUDGET_TURN_OUTPUT_TOKENS=100000
NHIS_BUDGET_TURN_COST_MICROS=2500000
NHIS_BUDGET_DAY_CALLS=2000
NHIS_BUDGET_DAY_INPUT_TOKENS=10000000
NHIS_BUDGET_DAY_OUTPUT_TOKENS=1000000
NHIS_BUDGET_DAY_COST_MICROS=25000000
NHIS_BUDGET_INPUT_USD_PER_MILLION=4
NHIS_BUDGET_OUTPUT_USD_PER_MILLION=20
NHIS_MODEL_KILL_SWITCH=false

# Byte quotas and explicit retention tools; no automatic removal of audits.
NHIS_STORAGE_CONVERSATION_BYTES=8388608
NHIS_STORAGE_WORKSPACE_BYTES=67108864
NHIS_STORAGE_RUN_BYTES=16777216
NHIS_STORAGE_INDEX_MAX_FILES=50000
NHIS_RETENTION_ANONYMOUS_DAYS=90
NHIS_RETENTION_COMPLETED_JOBS_DAYS=30
NHIS_RETENTION_CACHE_DAYS=30
NHIS_RETENTION_AUDIT_DAYS=365
