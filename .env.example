# Server-only configuration. Copy to .env and keep credentials out of Git.
# The browser cannot view or change these settings.
# Verify from your local terminal: bash scripts/start.command --test-api
# Ordinary chat uses this connection; optional blind measurement is additional.
NHIS_MODEL_PROVIDER=openai
NHIS_MODEL_BASE_URL=https://api.openai.com/v1
NHIS_MODEL_NAME=gpt-5.6-sol
OPENAI_API_KEY=

# Public browser access is opt-in locally. The Render preview enables it.
# Keep this separate from OPENAI_API_KEY. Public mode uses it to sign visitor
# cookies; private hosted mode uses it as the owner Basic-auth password.
# Required for either hosted mode, at least 32 random characters; never publish.
NHIS_PUBLIC_ACCESS=false
WEB_AUTH_SECRET=

# All limits must be integers from 1 through 100000. Hourly limits are per
# visitor; daily limits are global rolling 24-hour caps, not calendar-day quotas.
NHIS_PUBLIC_MESSAGES_PER_HOUR=20
NHIS_PUBLIC_MESSAGES_PER_DAY=200
NHIS_PUBLIC_CHATS_PER_HOUR=10
NHIS_PUBLIC_CHATS_PER_DAY=200
