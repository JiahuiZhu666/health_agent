# Fail closed: only production source enters the Docker build context.
**
!Dockerfile
!.dockerignore
!server.py
!nhis_agent/
!nhis_agent/*.py
!web/
!web/*.html
!web/*.css
!web/*.js
!config/
!config/registry.json
!scripts/
!scripts/analyze.R
!scripts/reference.do
!deploy/
!deploy/entrypoint.py

# Defense in depth against future allowlist changes.
**/.env
**/.env.*
**/*secret*
**/*credential*
**/*.pem
**/*.key
**/__pycache__/
**/*.pyc
.git/
.venv/
.r-env/
data/
runs/
conversations/
.cache/
*.zip
*.csv
*.pdf
