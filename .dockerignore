# Fail closed: only production source enters the Docker build context.
**
!Dockerfile
!.dockerignore
!server.py
!nhis_agent/
!nhis_agent/*.py
!web/
!web/*.html
!web/*.css
!web/*.js
!config/
!config/registry.json
!scripts/
!scripts/analyze.R
!scripts/reference.do
!scripts/state_admin.py
!scripts/model_admin.py
!scripts/validate_fixture.py
!tests/
!tests/fixtures/
!tests/fixtures/generate_survey.py
!tests/fixtures/reference_survey.R
!tests/fixtures/expected_metadata.json
!deploy/
!deploy/entrypoint.py

# Defense in depth against future allowlist changes.
**/.env
**/.env.*
**/*secret*
**/*credential*
**/*.pem
**/*.key
**/__pycache__/
**/*.pyc
.git/
.venv/
.r-env/
data/
runs/
conversations/
visitors/
.cache/
*.zip
*.csv
*.pdf
node_modules/
test-results/
playwright-report/
artifacts/
backups/
upgrades/
previews/
